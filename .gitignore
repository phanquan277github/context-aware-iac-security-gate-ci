# Deny by default for the public bootstrap. Review new paths before allowing them.
# Private docs, release candidates, research data, model binaries, virtual
# environments, caches, wheels, mirrors, Terraform state/plans, credentials,
# execution outputs and signing keys stay outside this initial allowlist.
/*
!/.gitignore
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/runner-smoke.yml
!/.github/workflows/toolchain-smoke.yml
!/.github/workflows/security-gate.yml
!/.github/workflows/security-gate-pr.yml
!/.github/ci_gate.py
!/.github/ci_gate_fixtures/
/.github/ci_gate_fixtures/*
!/.github/ci_gate_fixtures/pass/
/.github/ci_gate_fixtures/pass/*
!/.github/ci_gate_fixtures/pass/main.tf
!/.github/ci_gate_fixtures/review/
/.github/ci_gate_fixtures/review/*
!/.github/ci_gate_fixtures/review/main.tf
!/.github/ci_gate_fixtures/error/
/.github/ci_gate_fixtures/error/*
!/.github/ci_gate_fixtures/error/main.tf

!/security_gate_payload/
/security_gate_payload/**
!/security_gate_payload/ci-gate-v1.tar

!/.github/reporting/
/.github/reporting/*
!/.github/reporting/generate_report.py
!/.github/reporting/render.py
!/.github/reporting/test_reporting.py
!/.github/reporting/gate-result-v1.schema.json
